# Argus .env — the live copy is /root/argus/.env (chmod 600). Never commit real values
# and never paste them into a chat; add them on the box directly.

# Core — default destination for failure reports (core/report.js)
BITRIX_WEBHOOK_URL=
BITRIX_DIALOG_ID=

# AltomateHR plugin (plugins/altomatehr)
ALTOMATEHR_URL=
ALTOMATEHR_EMAIL=
ALTOMATEHR_PASSWORD=

# New apps: one block per plugin, every key prefixed with the app name in caps,
# e.g. plugins/my-app -> MY_APP_URL, MY_APP_EMAIL (or MY_APP_USERNAME), MY_APP_PASSWORD,
# optional MY_APP_LOGIN_URL. tools/deploy.sh refuses to deploy until they're set.
# Alerts (optional; unset = the default Bitrix chat above). Destinations, any mix:
#   MY_APP_NOTIFY=bitrix:chat1234, whatsapp:60123456789, email:ops@fusioneta.com, telegram:-1001234567890, slack:ops
# See .claude/skills/argus-new-test/notifications.md. Any channel key below can be
# overridden per app with a MY_APP_ prefix (e.g. MY_APP_SMTP_FROM).

# Channel credentials (secrets) — shared by all checks; fill in the ones you use.
# WhatsApp has no shared account: set MY_APP_WAZZUP_API_KEY / MY_APP_WAZZUP_CHANNEL_ID per app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
GOOGLECHAT_WEBHOOK_URL=
WEBHOOK_URL=
